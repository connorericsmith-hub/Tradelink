# Copy to .env and fill in. .env is gitignored; never commit real values.
#
#     cp .env.example .env
#
# Nothing here is required for `leadpipe selftest`, which runs entirely
# offline. You only need these once you start scraping and exporting.

# ---------------------------------------------------------------------------
# Config location (optional)
# ---------------------------------------------------------------------------
# Where your filled-in config lives. Defaults to ./config.yaml.
# LEADPIPE_CONFIG=./config.yaml

# ---------------------------------------------------------------------------
# Scraping (optional)
# ---------------------------------------------------------------------------
# Comma-separated proxy URLs. Leave unset to scrape from your own IP, which is
# free and works until Google decides it doesn't. When the pipeline reports a
# global block, this is the setting it is asking you for.
# The variable NAME is configurable — see scrape.proxies_env in config.yaml.
# LEADPIPE_PROXIES=http://user:pass@host:port,http://user:pass@host2:port

# ---------------------------------------------------------------------------
# Line-type verification (optional)
# ---------------------------------------------------------------------------
# Only used when compliance.verification.mode is "webhook".
# The pipeline POSTs {"phone": "+1..."} and expects
# {"line_type": "mobile"|"landline"|"voip"|"toll_free"}.
#
# Worth having. A landline validates as a perfectly real number, cannot
# receive a text, and bills you for every attempt to send one.
# LEADPIPE_LINETYPE_URL=https://your-verification-provider.example/lookup
# LEADPIPE_LINETYPE_TOKEN=

# ---------------------------------------------------------------------------
# Your CRM (optional — the pipeline exports CSV and does not call your CRM)
# ---------------------------------------------------------------------------
# This pipeline stops at a CRM-ready CSV on purpose: every CRM's import and
# automation API is different, and a scraper that also owns your sending is a
# scraper you cannot swap out. If you write your own uploader, keep its
# credentials here rather than in the config file.
# CRM_API_TOKEN=
# CRM_LOCATION_ID=
